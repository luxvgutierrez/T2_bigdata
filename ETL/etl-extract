import pandas as pd
from sqlalchemy import create_engine
import urllib
import os

# Configuración de conexión
server = 'MONITOR'
database = 'proyecto_dw'
driver = 'ODBC Driver 17 for SQL Server'
params = urllib.parse.quote_plus(f'DRIVER={driver};SERVER={server};DATABASE={database};Trusted_Connection=yes;')
engine = create_engine(f'mssql+pyodbc:///?odbc_connect={params}')

def extraer_todas_las_tablas():
    print("Conectando a SQL Server...")
    
    # Crear carpeta raw si no existe
    carpeta_salida = './raw'
    if not os.path.exists(carpeta_salida):
        os.makedirs(carpeta_salida)
        
    # Lista de todas las tablas que necesitas para tu modelo dimensional
    tablas_a_extraer = [
        'Fact_Ventas',
        'Fact_Compras',
        'Fact_Inventario_Snapshot',
        'Dim_Producto',
        'Dim_Cliente',
        'Dim_Proveedor',
        'Dim_Trabajador',
        'Dim_Tiempo'
    ]
    
    # Bucle para extraer y guardar cada tabla
    for tabla in tablas_a_extraer:
        print(f"Extrayendo datos de la tabla: {tabla}...")
        
        consulta_sql = f"SELECT * FROM {tabla}"
        
        try:
            # Leer datos de la tabla actual
            df_extraido = pd.read_sql(consulta_sql, con=engine)
            
            # Guardar en un CSV con el nombre de la tabla
            ruta_salida = f'{carpeta_salida}/{tabla}.csv'
            df_extraido.to_csv(ruta_salida, index=False, encoding='utf-8')
            
            print(f" -> Guardado exitoso: {ruta_salida}")
            
        except Exception as e:
            print(f" -> Error al extraer {tabla}: {e}")

    print("\n¡Extracción masiva completada!")

if __name__ == '__main__':
    extraer_todas_las_tablas()