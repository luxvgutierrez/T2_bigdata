"""
ORQUESTADOR (pipeline completo en una sola corrida):
Fase 1: Ingesta  (SQL Server -> raw)
Fase 2: Limpieza (raw -> processed, RNF03 + integridad referencial)
Fase 3: Auditoría (tiempos de respuesta, filas, cuarentena, histórico)
"""
import os
import sys

import config
from auditoria import Auditoria
from extraccion import conteo_bd, extraer_tabla, probar_conexion
from reglas_limpieza import procesar_tabla
from utilidades import (
    escribir_csv_atomico,
    guardar_cuarentena,
    ruta_procesado,
    ruta_raw,
)


def ejecutar() -> int:
    auditoria = Auditoria(config.CARPETA_AUDITORIA)

    # ------------------------------------------------------------------ #
    # Conexión
    # ------------------------------------------------------------------ #
    try:
        with auditoria.cronometrar('CONEXION') as crono:
            engine = config.crear_engine()
            probar_conexion(engine)
            crono.mensaje = f'Servidor: {config.SERVER} / BD: {config.DATABASE}'
    except Exception:
        auditoria.finalizar()
        return 1

    os.makedirs(config.CARPETA_RAW, exist_ok=True)
    os.makedirs(config.CARPETA_PROCESSED, exist_ok=True)

    dims_limpias = {}

    # Dimensiones primero, luego hechos (para la validación referencial)
    for tabla in config.TABLAS:
        try:
            # ---------- FASE 1: INGESTA ----------
            with auditoria.cronometrar('EXTRACCION', tabla) as crono:
                df = extraer_tabla(engine, tabla, auditoria=auditoria)
                # Verificación de ingesta: filas extraídas == filas en la BD
                conteo = conteo_bd(engine, tabla)
                if conteo != len(df):
                    raise RuntimeError(
                        f'Extracción incompleta: BD tiene {conteo} filas, '
                        f'se extrajeron {len(df)}'
                    )
                escribir_csv_atomico(df, ruta_raw(tabla))
                crono.detalle = {'conteo_bd': conteo, 'filas_leidas': len(df)}

            # ---------- FASE 2: LIMPIEZA ----------
            with auditoria.cronometrar('LIMPIEZA', tabla) as crono:
                resultado = procesar_tabla(df, tabla, dims=dims_limpias or None)
                crono.detalle = resultado['metricas']

            # ---------- Cuarentena de rechazos por reglas ----------
            with auditoria.cronometrar('CUARENTENA', tabla) as crono:
                ruta_q = guardar_cuarentena(resultado['rechazados'], tabla)
                crono.detalle = {
                    'filas_descartadas': len(resultado['rechazados']),
                    'mensaje': f'Rechazados en cuarentena: {ruta_q}' if ruta_q else 'Sin rechazos',
                }

            escribir_csv_atomico(resultado['limpio'], ruta_procesado(tabla))
            if tabla in config.TABLAS_DIMENSIONES:
                dims_limpias[tabla] = resultado['limpio']

            # ---------- Validación referencial ----------
            if tabla in config.TABLAS_CON_REFERENCIAL:
                n_huerf = len(resultado['huerfanos']) if resultado['huerfanos'] is not None else 0
                with auditoria.cronometrar('VALIDACION_REFERENCIAL', tabla) as crono:
                    ruta_h = guardar_cuarentena(resultado['huerfanos'], tabla, tipo='huerfanas')
                    crono.detalle = {
                        'huerfanos': n_huerf,
                        'mensaje': f'Huérfanos en cuarentena: {ruta_h}' if ruta_h else 'Sin huérfanos',
                    }

            auditoria.registrar_simple(
                'SISTEMA', tabla,
                f'Listo para Power BI: {os.path.basename(ruta_procesado(tabla))}',
            )
        except Exception:
            continue  # el fallo quedó registrado; la corrida continúa con las demás tablas

    resumen = auditoria.finalizar()
    return 1 if resumen['estado_global'] == 'CON_ERRORES' else 0


if __name__ == '__main__':
    sys.exit(ejecutar())
